<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <GridLayout
        android:id="@+id/gridStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvStatToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Today: €0.0"
            android:textSize="16sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tvStatWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="This Week: €0.0"
            android:textSize="16sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tvStatMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="This Month: €0.0"
            android:textSize="16sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tvStatTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Total Spent: €0.0"
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold"/>
    </GridLayout>

    <TextView
        android:id="@+id/tvTitleCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/gridStats"
        android:text="Expenses by Category:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/lvCategoryStats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvTitleCategory"
        android:layout_above="@id/layoutNavStats"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutNavStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/navHomeFromStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/navWalletsFromStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wallets"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/navStatsActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stats"
            android:textStyle="bold"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="More"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

</RelativeLayout>